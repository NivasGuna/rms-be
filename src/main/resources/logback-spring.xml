<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="rms-backend"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level app=${appName} trace_id=%X{traceId:-} span_id=%X{spanId:-} thread=%thread logger=%logger{36} msg="%msg"%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.springframework.security" level="INFO"/>
</configuration>
